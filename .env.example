# Environment template — copy to .env and fill in real values.
# NEVER commit .env. Secrets are scrubbed from all log output.

# معرّفات المشرفين مفصولة بفواصل (REQUIRED)
ADMINS=

# توكن البوت من @BotFather (REQUIRED) [secret]
BOT_TOKEN=

# postgresql+asyncpg://user:pass@host:5432/accounts_market (REQUIRED) [secret]
DATABASE_URL=

# مستوى السجلات
LOG_LEVEL=INFO

# ساعات الإفراج التلقائي عن الضمان إذا لم يشتكِ المشتري
AUTO_RELEASE_HOURS=72

# توكن مزود الدفع للـ Stars (اختياري — Stars لا تحتاجه) [secret]
ESCROW_STARS_PROVIDER_TOKEN=

# أقصى سعر لعرض
MAX_LISTING_PRICE=50000

# أدنى سعر لعرض (بالنجوم)
MIN_LISTING_PRICE=100

# نسبة عمولة المنصة (مثلاً 10 = 10%)
PLATFORM_FEE_PERCENT=10

# قناة نشر التقييمات (اختياري)
REVIEWS_CHANNEL_ID=

# مفتاح تشفير جلسات الحسابات (Fernet base64) — أنشئه عبر: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" (REQUIRED) [secret]
SESSION_ENCRYPTION_KEY=

# معرّف مجموعة الدعم الفني (مثل -1001234567890) (REQUIRED)
SUPPORT_CHAT_ID=

# Runtime options
ERROR_REPORT_TO_ADMINS=true
MBM_TEST=  # set to 1 to force in-memory storage inside pytest