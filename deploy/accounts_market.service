[Unit]
Description=Telegram Accounts Marketplace (generated by Master Bot Maker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/accounts_market
EnvironmentFile=/etc/accounts_market/.env
ExecStart=/opt/accounts_market/venv/bin/python /opt/accounts_market/main.py
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/accounts_market/data

[Install]
WantedBy=multi-user.target
# Install:
#   sudo mkdir -p /opt/accounts_market /etc/accounts_market
#   sudo cp -r . /opt/accounts_market/ && sudo cp .env /etc/accounts_market/.env
#   sudo useradd --system --home /opt/accounts_market bot || true
#   sudo chown -R bot:bot /opt/accounts_market /etc/accounts_market
#   sudo cp deploy/accounts_market.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now accounts_market
